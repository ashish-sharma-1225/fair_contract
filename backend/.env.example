# Application Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/clauselens_db

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=15728640

# Default User (for dev / demo authorization header X-User-Id fallback)
DEFAULT_USER_ID=usr_enterprise_01
